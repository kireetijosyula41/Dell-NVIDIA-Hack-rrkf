MONGODB_URI=mongodb://mongodb:27017
MONGODB_DATABASE=ceo_brain
DATA_DIR=/data
# Set on the GB10 after the NemoClaw operator confirms the local model server.
NEMOCLAW_MODEL_ID=
MODEL_API_BASE=
MODEL_API_KEY=
REASONER_MODE=deterministic
AUDIT_REASONER_MODE=deterministic
# The operator-provided local bridge receives { auditId, claim } and lets the
# NemoClaw sandbox submit its cited result to /tools/create-audit-warning.
NEMOCLAW_AUDIT_WEBHOOK_URL=
