# OrgBrain GB10 demo mode switch.
#
# Change only this value when you need to switch modes:
#   deterministic - immediate, reliable MongoDB evidence-graph demo
#   nemoclaw      - sends audits to the local NemoClaw bridge below
ORGBRAIN_REASONER_MODE=deterministic

# Keep true for the hackathon demo. If a NemoClaw audit fails or times out, the
# runner restarts the API in deterministic mode instead of failing the demo.
ORGBRAIN_ALLOW_DETERMINISTIC_FALLBACK=true

# Required only when ORGBRAIN_REASONER_MODE=nemoclaw. The model ID is displayed
# in /health; OpenShell owns the local inference.local model route.
NEMOCLAW_MODEL_ID=

# This must be the operator-managed NemoClaw bridge, not the model endpoint.
# The bridge receives /audits and calls back to /tools/create-audit-warning.
NEMOCLAW_AUDIT_WEBHOOK_URL=http://127.0.0.1:9000/audits

# Seconds to wait for the bridge to return warning_ready before falling back.
NEMOCLAW_AUDIT_TIMEOUT_SECONDS=45
